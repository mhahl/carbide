# Copy to .env and run ./setup.sh (it generates secrets on first run).
# DO NOT COMMIT .env.
# Defaults are single-host ready (everything via the carbide gateway
# 10.89.0.1, unreachable from outside); for remote sensors set API_BIND
# and SSH_HOST to this host's VPN/tailnet IP.
TAG=latest
API_BIND=10.89.0.1
API_PORT=8440
# Address sensors use to reach container sshd on THIS host.
SSH_HOST=10.89.0.1
# Generated on first setup (hex):
# SENSOR_TOKEN=
# DB_PASSWORD=
