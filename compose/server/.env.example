# Copy to .env and run ./setup.sh (it generates secrets on first run).
# DO NOT COMMIT .env.
# Defaults are single-host ready (everything via the carbide gateway
# 10.89.0.1, unreachable from outside); for remote sensors set API_BIND
# and SSH_HOST to this host's VPN/tailnet IP.
TAG=latest
API_BIND=10.89.0.1
API_PORT=8440
# Address sensors use to reach container sshd on THIS host.
SSH_HOST=10.89.0.1
# Blob store mount (whole "source:target[:opts]" fragment). Default is the
# named volume. For NFS, set NFS_EXPORT (or pass --nfs-export) and setup.sh
# mounts it, persists it in fstab, allows containers to use NFS, and points
# BLOB_MOUNT at it (no :z — NFS can't be relabeled; the boolean covers it).
# NFS_EXPORT=nas:/export/carbide-blobs
# NFS_MOUNTPOINT=/var/lib/carbide/blobs
# BLOB_MOUNT=carbide-blobs:/var/lib/carbide/blobs:z
# Web console: host side of the mapping (container serves 8080).
WEB_BIND=10.89.0.1
WEB_PORT=8080
# Sensor SSH management (optional): host path to the service-account
# private key; setup.sh stages it for the server (0600, never committed).
# MGMT_KEY_PATH=/root/.ssh/carbide-mgmt
# VirusTotal verdicts (optional): free Community API key from
# https://www.virustotal.com/gui/join-us (or pass --vt-key); verdicts
# stay off until a key exists. Public tier: 4 req/min, 500/day.
# VT_API_KEY=
# Generated on first setup (hex):
# SENSOR_TOKEN=
# DB_PASSWORD=
# ADMIN_PASSWORD=
