# Copy to .env and run ./setup.sh. DO NOT COMMIT .env.
TAG=latest
# Server API: the VPN/tailnet IP when remote, the carbide gateway below
# when co-located with the server on one host.
SERVER_HOST=10.89.0.1
SERVER_PORT=8440
SENSOR_ID=sensor-01                   # unique per sensor (affinity namespace)
SENSOR_TOKEN=CHANGE-ME                # shared token from the server's setup.sh
LISTEN_ADDR=0.0.0.0
LISTEN_PORT=2222
AUTH_PASSWORDS='"password", "123456", "admin", "letmein"'
ACCEPT_PROBABILITY=0.05
