# {{ ansible_managed }} — Carbide Squid config, rendered from squid/squid.conf.
# HTTP logging + HTTPS peek-and-splice (NO decryption). Attribution depends on
# the log format below staying in sync with carbide/server/squid.py.

# --- ports ---------------------------------------------------------------
http_port 3128
http_port 3129 intercept
# Peek-and-splice needs an ssl-bump port but never serves the dummy cert,
# because every connection is spliced, never bumped.
https_port 3130 intercept ssl-bump \
  cert=/etc/squid/splice-dummy.pem \
  generate-host-certificates=off

ssl_bump peek all
ssl_bump splice all

# --- who may use the proxy: carbide container networks only ---------------
acl containers src {{ carbide_container_subnet }}
http_access allow containers
http_access deny all

# --- never proxy cloud metadata / link-local ------------------------------
acl cloudmeta dst 169.254.169.254 169.254.170.2 100.100.100.200 \
  fd00:ec2::254
http_access deny cloudmeta

# --- safe ports ------------------------------------------------------------
acl SSL_ports port 443
acl Safe_ports port 80
acl Safe_ports port 443
http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports

# --- quotas: cap single response/request bodies -----------------------------
reply_body_max_size 50 MB
request_body_max_size 10 MB

# --- no disk cache: evidence lives in carbide, not in squid -----------------
cache deny all

# --- logging: native format consumed by carbide-server ----------------------
logformat carbide %ts.%03tu %6tr %>a %Ss/%03>Hs %<st %rm %ru %un %Sh/%<a %mt
access_log {{ carbide_squid_log_path }} carbide

# --- identity ----------------------------------------------------------------
visible_hostname carbide-egress
httpd_suppress_version_string on
