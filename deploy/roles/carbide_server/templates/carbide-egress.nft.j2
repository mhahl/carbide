# {{ ansible_managed }} — transparent-egress rules, rendered from
# squid/nftables.conf.snippet. Applied by the carbide-egress service at boot
# and whenever this file changes.
table inet carbide_egress {
    set container_nets {
        type ipv4_addr
        flags interval
        elements = { {{ carbide_container_subnet }} }
    }

    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        ip saddr @container_nets tcp dport 80 redirect to :3129
        ip saddr @container_nets tcp dport 443 redirect to :3130
    }

    chain forward_containers {
        # DNS only to the site resolver; everything else direct is dropped
        # (web goes via the proxy above).
        ip saddr @container_nets udp dport 53 ip daddr {{ carbide_nft_resolver }} accept
        ip saddr @container_nets ct state established,related accept
        ip saddr @container_nets drop
    }
{% if carbide_nft_hook_forward | default(true) %}
    # Base chain so forward_containers is actually evaluated. Policy accept:
    # only container-sourced traffic matching the drops above is affected.
    # A drop verdict here still applies even if firewalld accepts the packet
    # in its own forward chains (drop terminates, accept does not).
    chain forward_hook {
        type filter hook forward priority 0; policy accept;
        jump forward_containers
    }
{% endif %}
}
