[Unit]
Description=Carbide honeypot server (Podman, Squid, Postgres)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
# Root is required for the rootful Podman socket and container management.
User=root
ExecStart=/usr/local/bin/carbide-server -c /etc/carbide/config.toml
Restart=on-failure
RestartSec=5
ReadOnlyPaths=/etc/carbide
PrivateTmp=true

[Install]
WantedBy=multi-user.target
